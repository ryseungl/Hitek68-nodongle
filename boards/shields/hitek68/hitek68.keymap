#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        caps_bt: caps_bt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt BT_NXT>, <&kp CAPS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * 96 positions: 0-47 = left half, 48-95 = right half.
         * The right half is a mirrored PCB, so its rows below are listed
         * inner-to-outer (COL6 .. COL0), matching the physical key order.
         *
         * Layer 0 = Windows layout, Layer 1 = Mac layout
         * (identical except Ctrl and GUI are swapped).
         * Position 92 (right thumb, bottom-outer) is &tog 1 on both
         * layers: it switches Windows -> Mac and Mac -> Windows.
         *
         * Caps (position 16) uses the custom caps_bt hold-tap:
         * tap = Caps Lock, hold = &bt BT_NXT (hop to the next
         * Bluetooth profile). Layer 2 is unused.
         *
         * Position 31 / 79 = encoder push switch (matrix ROW3/COL7).
         * Encoder push (ROW3/COL7): left = play/pause, right = mute.
         */
        default_layer {
            bindings = <
                /* LEFT (0-47) */
                &kp ESC    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none &none
                &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T  &kp GRAVE &none
                &caps_bt    &kp A  &kp S  &kp D  &kp F  &kp G  &kp LBKT  &none
                &kp LSHIFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp RBKT  &kp C_PP
                &none &none &none &none &kp BSPC &kp SPACE &kp LCTRL &none
                &none &none &none &none &kp DEL  &kp LGUI  &kp LALT  &none
                /* RIGHT (48-95) */
                &kp BSPC   &kp N0 &kp N9 &kp N8 &kp N7 &kp N6 &none &none
                &kp BSLH   &kp P  &kp O  &kp I  &kp U  &kp Y  &kp MINUS &none
                &kp SQT    &kp SEMI &kp L &kp K &kp J  &kp H  &kp EQUAL &none
                &kp RSHIFT &kp FSLH &kp DOT &kp COMMA &kp M &kp N &kp TILDE &kp C_MUTE
                &none &none &none &none &kp ENTER &kp SPACE &kp RCTRL &none
                &none &none &none &none &tog 1    &kp RGUI  &kp RALT  &none
            >;
            /* sensor 0 = left encoder, sensor 1 = right encoder */
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        mac_layer {
            bindings = <
                /* LEFT (0-47) */
                &kp ESC    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none &none
                &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T  &kp GRAVE &none
                &caps_bt    &kp A  &kp S  &kp D  &kp F  &kp G  &kp LBKT  &none
                &kp LSHIFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp RBKT  &kp C_PP
                &none &none &none &none &kp BSPC &kp SPACE &kp LGUI &none
                &none &none &none &none &kp DEL  &kp LCTRL &kp LALT &none
                /* RIGHT (48-95) */
                &kp BSPC   &kp N0 &kp N9 &kp N8 &kp N7 &kp N6 &none &none
                &kp BSLH   &kp P  &kp O  &kp I  &kp U  &kp Y  &kp MINUS &none
                &kp SQT    &kp SEMI &kp L &kp K &kp J  &kp H  &kp EQUAL &none
                &kp RSHIFT &kp FSLH &kp DOT &kp COMMA &kp M &kp N &kp TILDE &kp C_MUTE
                &none &none &none &none &kp ENTER &kp SPACE &kp RGUI &none
                &none &none &none &none &tog 1    &kp RCTRL &kp RALT &none
            >;
            /* sensor 0 = left encoder, sensor 1 = right encoder */
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_two {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
